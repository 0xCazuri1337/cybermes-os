# --------------------------------------------------------------------------
# tasks (§20)
# --------------------------------------------------------------------------

# The task vocabulary is owned by `orch.store.TASK_STATES` and the `orch`
# layer MIGRATES this table into it (`migrate_tasks`: todo->planned,
# doing->running, done->completed) on every orchestrator open. These readers
# used to hardcode the pre-migration names, so after any orchestrator run they
# matched nothing: `next_task()` returned None while 18 claimable tasks sat in
# the table, and `wks.cli tasks` printed "no runnable task" — a clean,
# confident, EMPTY report over a full backlog. Same family as the
# validation_state / column-name traps: the filter, not the corpus, was wrong.
TASK_CLAIMABLE = ("planned", "ready", "running")
TASK_TERMINAL = ("completed", "superseded", "archived")
_LEGACY_TASK_STATUS = {"todo": "planned", "doing": "running",
                       "done": "completed", "rejected": "superseded"}


def normalise_task_status(status: str) -> str:
    """Accept a legacy or canonical task status; return the canonical one."""
    return _LEGACY_TASK_STATUS.get(status, status)


def add_task(
    con: sqlite3.Connection, task_key: str, objective: str,
    expected_artifact: str, *,
    class_id: str | None = None, priority: int = 5,
    assigned_role: str | None = None, depends_on: Iterable[str] | None = None,
    evidence_req: str | None = None,
) -> int:
    row = con.execute("SELECT id FROM task WHERE task_key=?", (task_key,)).fetchone()
    if row:
        return int(row["id"])
    cur = con.execute(
        """INSERT INTO task (task_key,objective,class_id,priority,status,assigned_role,
                              depends_on,expected_artifact,evidence_req,created_at,updated_at)
           VALUES (?,?,?,?,'todo',?,?,?,?,?,?)""",
        (task_key, objective, class_id, priority, assigned_role,
         json.dumps(list(depends_on or [])), expected_artifact, evidence_req, now(), now()),
    )
    return int(cur.lastrowid)


def claim_task(con: sqlite3.Connection, task_key: str, role: str) -> bool:
    """Atomically claim a runnable task. Idempotent for repeat runs.

    Writes the canonical `running` state, and accepts a task left in either
    vocabulary — the `orch` layer owns these names, so this writer must not
    invent a second one.
    """
    cur = con.execute(
        """UPDATE task SET status='running', assigned_role=?, updated_at=?
           WHERE task_key=? AND status IN
                 ('planned','ready','running','todo','doing')""",
        (role, now(), task_key),
    )
    return cur.rowcount > 0


def finish_task(
    con: sqlite3.Connection, task_key: str, status: str, result: str,
    follow_up: str | None = None,
) -> None:
    con.execute(
        "UPDATE task SET status=?, result=?, follow_up=?, updated_at=? WHERE task_key=?",
        (normalise_task_status(status), result, follow_up, now(), task_key),
    )


def next_task(con: sqlite3.Connection, roles: list[str] | None = None) -> sqlite3.Row | None:
    """Highest-priority runnable task. Deps must be terminal (completed).

    Reads the canonical vocabulary AND the legacy names, because a task can be
    written by either layer and the table carries no CHECK constraint. Selecting
    on `todo`/`doing` only was the reason this returned None over a full
    backlog; a task whose deps never completed is still skipped, so the fix
    widens the filter without weakening the dependency gate.
    """
    rows = con.execute(
        "SELECT * FROM task WHERE status IN "
        "('planned','ready','running','todo','doing') ORDER BY priority, id"
    ).fetchall()
    terminal = {
        r["task_key"] for r in con.execute(
            "SELECT task_key FROM task WHERE status IN "
            "('completed','done','superseded','archived','rejected')"
        ).fetchall()
    }
    for r in rows:
        deps = json.loads(r["depends_on"] or "[]")
        if any(d not in terminal for d in deps):
            continue
        if roles and r["assigned_role"] and r["assigned_role"] not in roles:
            continue
        return r
    return None


