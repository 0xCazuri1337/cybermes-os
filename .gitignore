# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Databases: the canonical db IS committed; everything else is derived ----
db/*.db-wal
db/*.db-shm
db/wks-pre-*.db
db/*.db.bak*
db/*.bak
*.sqlite-journal

# ---- Third-party / licensed corpora: NOT in this repo ----
# research/corpus/   mirrored HTB / TryHackMe writeups + official PDFs (others' IP)
# research/tmp/      raw mirrors of third-party specs (OpenID Connect, cheat sheets)
# cache/             fetched HTML/Markdown page cache (nvd, notion, hacktricks...)
# quarantine/        quarantined pre-refactor material, kept offline in backups
research/corpus/
research/tmp/
cache/
quarantine/

# ---- Runtime + local execution state ----
runtime/hunts/
runtime/state/
*.log
*.jsonl
!CONTROL/**/*.md

# ---- Secrets: never, in any form ----
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*_rsa
id_rsa*
id_ed25519*
*credentials*
*cookie*
secrets/

# ---- OS / editor noise ----
Thumbs.db
.DS_Store
desktop.ini
*.swp
.idea/
.vscode/
